# Copy this file to .env and fill in your real values.

# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Used to sign JWT access tokens. Any long random string works.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_with_a_random_secret

# Used to sign refresh tokens. Must be a DIFFERENT value from JWT_SECRET.
JWT_REFRESH_SECRET=replace_this_with_a_different_random_secret

# Set to "production" on your deployed server. Leaving this unset (or
# "development") allows JWT_SECRET/JWT_REFRESH_SECRET to fall back to
# insecure dev defaults — never do that in production.
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins. Defaults to localhost
# if unset. Add your deployed Vercel URL here before going live.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000