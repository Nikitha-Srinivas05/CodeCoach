# Copy this file to .env and fill in your real values.
# Never commit the actual .env file — it's already in .gitignore.

# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Used to sign JWT access tokens. Any long random string works.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_with_a_random_secret

# Used to sign refresh tokens. Must be a DIFFERENT value from JWT_SECRET.
JWT_REFRESH_SECRET=replace_this_with_a_different_random_secret
